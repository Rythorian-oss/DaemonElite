<Window x:Class="DaemonElite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaemonElite.Controls"
        Title="DaemonElite"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
  <Window.Effect>
    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="#000000" />
  </Window.Effect>

  <Border Background="{StaticResource VoidBrush}" BorderBrush="#304060" BorderThickness="1" CornerRadius="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
        <RowDefinition Height="186" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#0B1020" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="9" Background="#183E58" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1">
              <Grid>
                <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path Stroke="{StaticResource CyanBrush}" StrokeThickness="1.3" Data="M6,17 L13,11 L19,22 L27,8" />
              </Grid>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="DAEMONELITE" FontFamily="Cascadia Mono" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
              <TextBlock Text="VOICE CONTROL SYSTEM / 02.0" Style="{StaticResource MonoStyle}" FontSize="9" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" Margin="0,0,8,0" />
            <TextBlock Text="AUDIO ENGINE ONLINE" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource MintBrush}" />
            <TextBlock Text="  •  44.1 KHZ  •  STEREO READY" Style="{StaticResource MonoStyle}" FontSize="9" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" />
            <Button Content="□" Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" />
            <Button Content="×" Style="{StaticResource WindowButtonStyle}" Foreground="{StaticResource DangerBrush}" Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="22,18,22,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.03*" />
          <ColumnDefinition Width="2.1*" />
          <ColumnDefinition Width="1.12*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="CAPTURE DECK" Style="{StaticResource EyebrowStyle}" />
              <TextBlock Text="Record a signal" Style="{StaticResource TitleStyle}" FontSize="21" Margin="0,6,0,0" />
              <TextBlock Text="Route your voice through the active profile." Style="{StaticResource BodyStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="#0B1020" CornerRadius="8" Margin="0,22,0,16" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="#392139">
                  <TextBlock Text="●" Foreground="{StaticResource DangerBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="INPUT CHANNEL 01" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                  <TextBlock Text="Microphone / Default" Style="{StaticResource MonoStyle}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Grid.Row="2">
              <Button x:Name="RecordButton" Content="●  START RECORDING" Style="{StaticResource PrimaryButtonStyle}" Height="44" Click="Record_Click" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="StopButton" Content="■  STOP" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" Height="38" Click="Stop_Click" />
                <Button Grid.Column="1" x:Name="PlayButton" Content="▶  PLAY" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" Height="38" Click="Play_Click" />
              </Grid>
              <Button x:Name="ClearButton" Content="RESET SESSION" Style="{StaticResource DangerButtonStyle}" Margin="0,10,0,0" Height="34" Click="Clear_Click" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,18,0,0">
              <Grid>
                <TextBlock Text="SESSION STATUS" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="StatusText" Text="READY" Style="{StaticResource MonoStyle}" HorizontalAlignment="Right" Foreground="{StaticResource MintBrush}" />
              </Grid>
              <ProgressBar x:Name="SignalMeter" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0"
                           Background="#202B45" Foreground="{StaticResource CyanBrush}" BorderThickness="0" />
              <Button x:Name="ExportButton" Content="↗  EXPORT WAV" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0" Height="36" Click="Export_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <StackPanel>
                <TextBlock Text="SIGNAL ANALYSIS" Style="{StaticResource EyebrowStyle}" />
                <TextBlock Text="Live waveform" Style="{StaticResource TitleStyle}" FontSize="21" Margin="0,6,0,0" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PEAK" Style="{StaticResource MonoStyle}" FontSize="9" Margin="0,0,8,0" />
                <TextBlock x:Name="PeakText" Text="-∞ dB" Style="{StaticResource MonoStyle}" Foreground="{StaticResource CyanBrightBrush}" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#080D1A" BorderBrush="#1A2B49" BorderThickness="1" CornerRadius="9" Margin="0,18,0,14" Padding="12">
              <controls:AudioVisualizer x:Name="Visualizer" />
            </Border>
            <Grid Grid.Row="2">
              <TextBlock Text="INPUT" Style="{StaticResource MonoStyle}" FontSize="9" />
              <TextBlock Text="FFT / 1024 BINS" Style="{StaticResource MonoStyle}" FontSize="9" HorizontalAlignment="Center" />
              <TextBlock Text="OUTPUT MONITOR" Style="{StaticResource MonoStyle}" FontSize="9" HorizontalAlignment="Right" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="VOICE PROFILES" Style="{StaticResource EyebrowStyle}" />
            <Grid Grid.Row="1" Margin="0,10,0,12">
              <TextBlock Text="Choose a character" Style="{StaticResource TitleStyle}" FontSize="18" />
              <TextBlock x:Name="PresetCountText" Text="15" Style="{StaticResource MonoStyle}" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
            <ListBox x:Name="PresetList" Grid.Row="2" Style="{StaticResource QuietListBoxStyle}" ItemContainerStyle="{StaticResource PresetItemStyle}"
                     SelectionChanged="PresetList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1B3851">
                      <TextBlock Text="{Binding Glyph}" Foreground="{StaticResource CyanBrightBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Category}" Style="{StaticResource MonoStyle}" FontSize="9" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="18" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" Background="#0B1020" CornerRadius="7" Padding="10" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource EyebrowStyle}" FontSize="9" Foreground="{StaticResource VioletBrush}" />
                <TextBlock x:Name="SelectedPresetText" Text="Normal" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock x:Name="EffectText" Text="Clean signal" Style="{StaticResource MonoStyle}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="#0A0F1D" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14,22,18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="SYSTEM CONSOLE" Style="{StaticResource EyebrowStyle}" />
            <TextBlock x:Name="ConsoleStatus" Text="DAEMONELITE / READY" Style="{StaticResource MonoStyle}" HorizontalAlignment="Right" Foreground="{StaticResource MintBrush}" />
          </Grid>
          <Border Grid.Row="1" Background="#070B15" BorderBrush="#182542" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="10,7">
            <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="ConsoleText" FontFamily="Cascadia Mono" FontSize="10" Foreground="#6BA1B9" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>