<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DaemonElite</AssemblyName>
    <RootNamespace>DaemonElite</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationIcon />
    <AssemblyTitle>DaemonElite</AssemblyTitle>
    <AssemblyDescription>A focused real-time voice studio for recording, shaping, and exporting sound.</AssemblyDescription>
    <Company>Black Star Labs</Company>
    <Product>DaemonElite Voice Studio</Product>
    <Copyright>Copyright © 2026 Black Star Labs</Copyright>
    <Version>2.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>